# Copy to .env.local (already gitignored) and fill in.

# Required — agent loop won't run without this.
ANTHROPIC_API_KEY=

# Optional — defaults to claude-sonnet-5.
NOMAD_MODEL=

# Set after running contracts/script/DeployFactory.s.sol against Monad testnet.
NOMAD_FACTORY_ADDRESS=

# Kuru Flow (docs.monad.xyz/guides/kuru-flow) — Monad's swap aggregator, used by prepare_swap.
# Optional — defaults to https://ws.kuru.io. Only override for a staging/alt Kuru Flow host.
KURU_FLOW_API_BASE=
# Optional — your address to collect a referral fee on swaps you route (basis points, e.g. 50 = 0.5%).
KURU_REFERRER_ADDRESS=
KURU_REFERRER_FEE_BPS=

# Optional comma-separated SYMBOL:0xaddress pairs shown in wallet_overview / usable in prepare_send.
NOMAD_KNOWN_TOKENS=

# Required for get_transaction_history — Monadscan's Etherscan-compatible API, used to fetch
# a wallet's recent activity (native sends, ERC-20 transfers, contract calls). Get a free key
# at https://etherscan.io/apis (works across chains via chainid=10143 for Monad testnet).
ETHERSCAN_API_KEY=

# Optional — only needed for WalletConnect-based wallets in RainbowKit. Get one free at https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
